#!/bin/bash

CONFIG_DIR="${CONFIG_DIR:-/Users/cchelo/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# YASB Monochrome palette
BACKGROUND=0xff18181b
BACKGROUND2=0xff3f3f42
ACCENT=0xffb2b2b2
TEXT=0xffe5e7eb
TEXT_MUTED=0xffb2b2b2
TEXT_DIM=0x9ee5e7eb
BORDER=0xff3f3f42
TRANSPARENT=0x00000000

sketchybar --bar position=top \
                 height=42 \
                 topmost=on \
                 blur_radius=0 \
                 color=$BACKGROUND \
                 padding_left=14 \
                 padding_right=14 \
                 border_width=1 \
                 border_color=$BORDER \
                 shadow=off

default=(
  padding_left=3
  padding_right=3
  icon.font="JetBrainsMono Nerd Font:Bold:14.0"
  label.font="JetBrainsMono Nerd Font Mono:Bold:12.0"
  icon.color=$TEXT
  label.color=$TEXT
  icon.padding_left=3
  icon.padding_right=3
  label.padding_left=4
  label.padding_right=4
  label.y_offset=0
  icon.y_offset=0
  background.drawing=off
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event window_focus

separator=(
  icon="|"
  icon.color=$TEXT_MUTED
  icon.font="JetBrainsMono Nerd Font Mono:Bold:12.0"
  icon.padding_left=7
  icon.padding_right=7
  label.drawing=off
  background.drawing=off
)

for sid in 1 2 3 4; do
  sketchybar --add item workspace.$sid left \
             --subscribe workspace.$sid aerospace_workspace_change window_focus front_app_switched \
             --set workspace.$sid \
                   icon="$sid" \
                   label.drawing=off \
                   icon.font="JetBrainsMono Nerd Font Mono:Bold:12.0" \
                   icon.color=$TEXT_DIM \
                   icon.padding_left=12 \
                   icon.padding_right=12 \
                   padding_left=0 \
                   padding_right=0 \
                   background.drawing=off \
                   update_freq=2 \
                   click_script="aerospace workspace $sid" \
                   script="
                     FOCUSED=\$(aerospace list-workspaces --focused 2>/dev/null)

                     if [ \"\$FOCUSED\" = \"$sid\" ]; then
                       sketchybar --set \$NAME icon.color=$TEXT icon.font='JetBrainsMono Nerd Font Mono:Bold:12.0'
                     else
                       sketchybar --set \$NAME icon.color=$TEXT_MUTED icon.font='JetBrainsMono Nerd Font Mono:Bold:12.0'
                     fi
                   "
done

sketchybar --add item separator.front_app left \
           --set separator.front_app "${separator[@]}"

sketchybar --add item front_app left \
           --set front_app \
                 icon.drawing=off \
                 label.color=$TEXT \
                 label.font="JetBrainsMono Nerd Font Mono:Bold:12.0" \
                 label.padding_left=4 \
                 label.padding_right=10 \
                 update_freq=5 \
                 script="
                   APP_NAME=\"\$INFO\"

                   if [ -z \"\$APP_NAME\" ]; then
                     APP_NAME=\$(aerospace list-windows --focused --format '%{app-name}' 2>/dev/null)
                   fi

                   if [ -z \"\$APP_NAME\" ]; then
                     APP_NAME=\$(osascript -e 'tell application \"System Events\" to get name of first application process whose frontmost is true' 2>/dev/null)
                   fi

                   sketchybar --set \$NAME label=\"\$APP_NAME\"
                 " \
           --subscribe front_app front_app_switched window_focus aerospace_workspace_change

sketchybar --add item clock right \
           --set clock update_freq=10 \
                       icon.drawing=off \
                       label.color=$TEXT \
                       label.font="JetBrainsMono Nerd Font Mono:Bold:12.0" \
                       label.padding_left=10 \
                       label.padding_right=10 \
                       script="sketchybar --set \$NAME label=\"\$(date '+%a, %d %b %H:%M')\""

sketchybar --add item separator.clock right \
           --set separator.clock "${separator[@]}"

sketchybar --add item battery right \
           --set battery update_freq=120 \
                         icon.color=$TEXT \
                         label.color=$TEXT \
                         icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
                         label.font="JetBrainsMono Nerd Font Mono:Bold:12.0" \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add item separator.battery right \
           --set separator.battery "${separator[@]}"

sketchybar --add item volume right \
           --set volume icon.color=$TEXT \
                        label.color=$TEXT \
                        icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
                        label.font="JetBrainsMono Nerd Font Mono:Bold:12.0" \
                        script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

sketchybar --add bracket left_block \
  workspace.1 workspace.2 workspace.3 workspace.4 \
  separator.front_app front_app \
  --set left_block background.drawing=off \
                   background.height=34 \
                   background.corner_radius=0 \
                   background.padding_left=0 \
                   background.padding_right=0

sketchybar --add bracket right_block volume separator.battery battery separator.clock clock \
           --set right_block background.drawing=off \
                             background.height=34 \
                             background.corner_radius=0 \
                             background.padding_left=0 \
                             background.padding_right=0

sketchybar --update
